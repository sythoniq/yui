// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id   Int   @id @default(autoincrement()) 
    user_name String  @unique
    user_hash String

    received_messages Message[] @relation("MessageReceiver")
    sent_messages Message[] @relation("MessageSender")

    profile_image Profile[]
}

model Message {
  message_id  Int   @id @default(autoincrement())
    message_content String
    message_date    DateTime  @default(now())

    sender      User @relation("MessageSender", fields: [sender_id], references: [user_id])
    sender_id   Int

    receiver    User @relation("MessageReceiver", fields: [receiver_id], references: [user_id])
    receiver_id Int
}

// Strictly to provide a way to have images as pfps...
model Profile {
  image_id  Int   @id @default(autoincrement())
    image_bytea Bytes

    user_profile User @relation(fields: [profile_id], references: [user_id])
    profile_id  Int
}
